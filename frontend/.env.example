# FastAPI backend (retrieval and repositories). Server-side only.
API_URL=http://localhost:8000

# LM Studio (OpenAI-compatible API). Server-side only.
LMSTUDIO_HOST=http://localhost:1234
LLM_MODEL=openai/gpt-oss-20b

# Postgres for auth and chat history (the Supabase database works).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
